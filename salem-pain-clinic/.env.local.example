# Copy to .env.local. Leave unset if you do not use Gemini.
GEMINI_API_KEY=

# Contact email via Resend. Set all three values to enable email delivery.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=

# Optional contact delivery and search verification.
CONTACT_FORM_FORWARD_URL=
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_GOOGLE_VERIFICATION_TOKEN=
